hal_attribute(lenovodisplay)

type hal_lenovodisplay_service, hal_service_type, service_manager_type;
hal_attribute_service(hal_lenovodisplay, hal_lenovodisplay_service)
binder_use(hal_lenovodisplay_server)

type hal_lenovodisplay_default, domain;
hal_server_domain(hal_lenovodisplay_default, hal_lenovodisplay)

type hal_lenovodisplay_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lenovodisplay_default)

allow hal_lenovodisplay_default proc:file rw_file_perms;
allow hal_lenovodisplay_default sysfs:file rw_file_perms;
