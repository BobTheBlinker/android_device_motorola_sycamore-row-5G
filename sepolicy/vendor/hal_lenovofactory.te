hal_attribute(lenovofactory)

type hal_lenovofactory_service, hal_service_type, service_manager_type;
hal_attribute_service(hal_lenovofactory, hal_lenovofactory_service)
binder_use(hal_lenovofactory_server)

type hal_lenovofactory_default, domain;
hal_server_domain(hal_lenovofactory_default, hal_lenovofactory)

type hal_lenovofactory_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lenovofactory_default)

allow hal_lenovofactory_default { block_device gsi_metadata_file metadata_file }:dir search;
allow hal_lenovofactory_default nvram_device:blk_file rw_file_perms;
allow hal_lenovofactory_default proc_bootconfig:file r_file_perms;
r_dir_file(hal_lenovofactory_default, sysfs_dt_firmware_android)
set_prop(hal_lenovofactory_default, vendor_mtk_factory_prop)
