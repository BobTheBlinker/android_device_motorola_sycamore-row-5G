hal_attribute(lenovoperformance)

type hal_lenovoperformance_service, hal_service_type, service_manager_type;
hal_attribute_service(hal_lenovoperformance, hal_lenovoperformance_service)
binder_use(hal_lenovoperformance_server)

type hal_lenovoperformance_default, domain;
hal_server_domain(hal_lenovoperformance_default, hal_lenovoperformance)

type hal_lenovoperformance_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lenovoperformance_default)

allow hal_lenovoperformance_default { sysfs_ged sysfs_therm }:dir search;
allow hal_lenovoperformance_default { sysfs sysfs_devices_system_cpu sysfs_ged sysfs_therm }:file rw_file_perms;
