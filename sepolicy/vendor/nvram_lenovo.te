type nvram_lenovo, domain;
type nvram_lenovo_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(nvram_lenovo)

allow nvram_lenovo self:capability { chown fowner fsetid };

allow nvram_lenovo { block_device metadata_file mnt_vendor_file }:dir search;
allow nvram_lenovo gsi_metadata_file:dir r_dir_perms;
allow nvram_lenovo { bootdevice_block_device nvdata_device nvram_device }:blk_file rw_file_perms;
allow nvram_lenovo { nvram_device pro_info_device }:chr_file rw_file_perms;
allow nvram_lenovo kmsg_device:chr_file w_file_perms;

allow nvram_lenovo { nvdata_file nvram_data_file }:dir create_dir_perms;
allow nvram_lenovo { nvdata_file nvram_data_file }:file create_file_perms;
allow nvram_lenovo { nvdata_file nvram_data_file }:lnk_file read;
allow nvram_lenovo nvram_data_file:lnk_file unlink;

allow nvram_lenovo { proc_bootconfig proc_cmdline sysfs_boot_mode }:file r_file_perms;
allow nvram_lenovo proc_lk_env:file rw_file_perms;
allow nvram_lenovo sysfs:dir read;
r_dir_file(nvram_lenovo, sysfs_dt_firmware_android)

set_prop(nvram_lenovo, vendor_lenovotb_init_prop)
set_prop(nvram_lenovo, vendor_mtk_service_nvram_init_prop)

# ro.odm.lenovo.* from odm/vendor build.prop
set_prop(vendor_init, vendor_lenovotb_init_prop)
