hal_attribute(lenovousb)

type hal_lenovousb_service, hal_service_type, service_manager_type;
hal_attribute_service(hal_lenovousb, hal_lenovousb_service)
binder_use(hal_lenovousb_server)

type hal_lenovousb_default, domain;
hal_server_domain(hal_lenovousb_default, hal_lenovousb)

type hal_lenovousb_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lenovousb_default)

allow hal_lenovousb_default sysfs:file rw_file_perms;
