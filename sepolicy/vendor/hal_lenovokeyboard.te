hal_attribute(lenovokeyboard)

type hal_lenovokeyboard_service, hal_service_type, service_manager_type;
hal_attribute_service(hal_lenovokeyboard, hal_lenovokeyboard_service)
binder_use(hal_lenovokeyboard_server)

type hal_lenovokeyboard_default, domain;
hal_server_domain(hal_lenovokeyboard_default, hal_lenovokeyboard)

type hal_lenovokeyboard_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lenovokeyboard_default)

allow hal_lenovokeyboard_default device:dir r_dir_perms;
allow hal_lenovokeyboard_default lenovo_keyboard_device:chr_file rw_file_perms;
allow hal_lenovokeyboard_default sysfs_kb:dir search;
allow hal_lenovokeyboard_default sysfs_kb:file rw_file_perms;
