hal_attribute(lenovobattery)

type hal_lenovobattery_service, hal_service_type, service_manager_type;
hal_attribute_service(hal_lenovobattery, hal_lenovobattery_service)
binder_use(hal_lenovobattery_server)

type hal_lenovobattery_default, domain;
hal_server_domain(hal_lenovobattery_default, hal_lenovobattery)

type hal_lenovobattery_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lenovobattery_default)

allow hal_lenovobattery_default sysfs_batteryinfo:dir search;
allow hal_lenovobattery_default { sysfs sysfs_batteryinfo }:file rw_file_perms;
dontaudit hal_lenovobattery_default persist_debug_prop:file r_file_perms;
